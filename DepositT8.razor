overhead 'insert gold in STUFFCHEST'
    getlabel GOLD 'label'
overhead 'label'
lift GOLD 60000
pause 50
drop 'STUFFCHEST' -1 -1 0
pause 550
ignore GOLD
clearignore
endwhile

