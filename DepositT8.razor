endif

overhead 'deposit...' 1150
foreach t in 'lootTypesT8'
    while findtype t backpack as loot
        getlabel loot lootLabel
        overhead lootLabel 1150
        lift loot 999
        drop STUFFCHEST -1 -1 -1
        wait 500
    endwhile
endfor


while findtype 3821 backpack as GOLD
overhead 'insert gold in STUFFCHEST'
    getlabel GOLD 'label'
overhead 'label'
lift GOLD 60000
pause 50
drop 'STUFFCHEST' -1 -1 0
pause 550
ignore GOLD
clearignore
endwhile
    
pause 200

//Ground runes/Floor runes
if findtype 39889|39891|39892|39896|39897|39898|39905|39909|39911|39912|39916|39917|39918 backpack as special
    overhead 'insert Special Rune into Senator Chest'
    dclick 0x4058C1F3
    pause 200
    menu 0x406E7E92 0
endif
pause 600
//end section

overhead 'ALL DONE! Nice Job' 44
